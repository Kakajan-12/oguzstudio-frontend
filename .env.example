# API used by the server to render pages
API_URL=http://localhost:4000
# API used by the browser for the contact and job application forms
NEXT_PUBLIC_API_URL=http://localhost:4000
# Shared with the API (SITE_REVALIDATE_SECRET): lets it refresh the site after admin changes
REVALIDATE_SECRET=
# reCAPTCHA v2 site key; leave empty to hide the captcha in development
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
